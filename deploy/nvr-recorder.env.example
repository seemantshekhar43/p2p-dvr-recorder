# /etc/nvr-recorder/env  (chmod 600, root only). Every value below can be changed.

# --- Device (required) ---
CAM_SERIAL=            # InstaOn / Easy4ip device serial
CAM_PASSWORD=
CAM_USER=admin

# --- Tunnel ---
NVR_LISTEN=1554        # local port the DVR's RTSP is exposed on (127.0.0.1)
NVR_REMOTE=554         # DVR's RTSP port
NVR_CLOUD=auto         # instaon | easy4ip | auto
NVR_BUSY_RETRY=120     # seconds to keep retrying while the DVR holds an old relay session

# --- Recording ---
CHANNELS="1 2 3 4 5 6" # channels to record, and to health-check
SUBTYPE=0              # 0 = main stream, 1 = sub-stream
# SUBTYPE_3=1          # per-channel override, e.g. record channel 3 on the sub-stream
REC_DIR=/mnt/recordings
SEGMENT_SECONDS=1800   # segment length

# --- Retention and alerts ---
RETENTION_HOURS=48
QUOTA_GB=150           # disk allocation the watchdog measures against
QUOTA_ALERT_PCT=90
STALE_SECONDS=180      # alert if a channel's newest segment is older than this
# NTFY_URL=https://ntfy.example.com/your-topic
