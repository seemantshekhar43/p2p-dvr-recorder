# /etc/nvr-recorder/env (mode 600, root only). Read by systemd and by the nvr-* scripts.
# Keep comments on their own lines: systemd does not strip trailing comments.

# --- Device (required) ---
# InstaOn / Easy4ip device serial
CAM_SERIAL=
CAM_USER=admin
CAM_PASSWORD=

# --- Tunnel ---
# Local port the DVR's RTSP is exposed on (127.0.0.1 only)
NVR_LISTEN=1554
# DVR's RTSP port
NVR_REMOTE=554
# instaon | easy4ip | auto
NVR_CLOUD=auto
# Seconds to keep retrying while the DVR holds an old relay session
NVR_BUSY_RETRY=120
# The relay drops a session after about 40 minutes, so the tunnel opens a fresh one after this many minutes
# (0 disables). Avoids about 30 s of lost footage every 40 minutes.
NVR_ROTATE_MINUTES=36

# --- Recording ---
# Where recordings are stored (one subdirectory per channel)
REC_DIR=/mnt/recordings
# Channels to record and health-check
CHANNELS="1 2 3 4 5 6"
# 0 = main stream, 1 = sub-stream
SUBTYPE=0
# Per-channel override, e.g. record channel 3 on the sub-stream:
# SUBTYPE_3=1
# Length of each segment file, in seconds
SEGMENT_SECONDS=1800

# --- Retention and alerts ---
# How many hours of footage to keep
RETENTION_HOURS=48
# Disk allocation the watchdog measures against, and the alert threshold
QUOTA_GB=150
QUOTA_ALERT_PCT=90
# Alert if a channel's newest segment is older than this many seconds
STALE_SECONDS=180
# ntfy topic URL for alerts (optional)
# NTFY_URL=https://ntfy.example.com/your-topic
# Access token if the ntfy server requires auth (sent as a Bearer token)
# NTFY_TOKEN=

# --- Web viewer (browse and play recordings) ---
# Listen address. 127.0.0.1 = this host only; 0.0.0.0 = all interfaces (set a password first!)
VIEWER_BIND=127.0.0.1
VIEWER_PORT=8080
# Camera names shown in the viewer, comma separated, in CHANNELS order (blank = CH1, CH2, ...)
# VIEWER_NAMES=Gate,Hall,Garden
# Basic-auth login. Leave the password empty for no auth (only safe on 127.0.0.1)
VIEWER_USER=viewer
VIEWER_PASSWORD=
# Size cap for the MP4 remux cache, in MB
VIEWER_CACHE_MB=2048
