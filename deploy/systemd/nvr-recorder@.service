[Unit]
Description=NVR recorder, channel %i
After=nvr-tunnel.service
Requires=nvr-tunnel.service

[Service]
EnvironmentFile=/etc/nvr-recorder/env
User=nvr
Group=nvr
ExecStart=/usr/local/bin/nvr-record %i
Restart=always
RestartSec=1
# A tunnel rotation or reconnect takes a few seconds; retry quickly and never hit the start limit.
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
