[Unit]
Description=NVR recorder, channel %i
After=nvr-tunnel.service
Wants=nvr-tunnel.service
# A tunnel rotation or outage can last longer than systemd's default start limit (5 starts in 10 s);
# without this the units end up `failed` and never recover. Must be in [Unit], it is ignored in [Service].
StartLimitIntervalSec=0

[Service]
EnvironmentFile=/etc/nvr-recorder/env
User=nvr
Group=nvr
ExecStart=/usr/local/bin/nvr-record %i
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
