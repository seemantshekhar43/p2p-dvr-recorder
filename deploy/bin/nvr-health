#!/bin/sh
# Per-minute check: newest segment per channel is fresh, disk use under the
# allocation. Alerts on state change only (ntfy), always logs to stdout.
set -u
: "${REC_DIR:=/mnt/recordings}" "${CHANNELS:=1 2 3 4 5 6}" "${QUOTA_GB:=150}" "${QUOTA_ALERT_PCT:=90}"
: "${STALE_SECONDS:=180}" "${STATE_DIR:=${RUNTIME_DIRECTORY:-/run/nvr-health}}"
mkdir -p "$STATE_DIR"
now=$(date +%s)
problems=""
for ch in $CHANNELS; do
  newest=$(find "$REC_DIR/ch$ch" -type f -name '*.mkv' -printf '%T@\n' 2>/dev/null | sort -n | tail -1 | cut -d. -f1)
  if [ -z "$newest" ]; then problems="$problems ch$ch:no-segments"
  elif [ $((now - newest)) -gt "$STALE_SECONDS" ]; then problems="$problems ch$ch:stale-$((now - newest))s"; fi
done
used_kb=$(du -sk "$REC_DIR" | cut -f1)
limit_kb=$((QUOTA_GB * 1024 * 1024 * QUOTA_ALERT_PCT / 100))
[ "$used_kb" -gt "$limit_kb" ] && problems="$problems disk:$((used_kb / 1024 / 1024))GB>${QUOTA_ALERT_PCT}%of${QUOTA_GB}GB"
prev=$(cat "$STATE_DIR/problems" 2>/dev/null || true)
echo "$problems" >"$STATE_DIR/problems"
if [ -n "$problems" ]; then echo "UNHEALTHY:$problems"; else echo "ok used=$((used_kb / 1024))MB"; fi
if [ "$problems" != "$prev" ] && [ -n "${NTFY_URL:-}" ]; then
  if [ -n "$problems" ]; then msg="nvr-recorder problems:$problems"; else msg="nvr-recorder recovered"; fi
  curl -fsS -m 10 -d "$msg" "$NTFY_URL" >/dev/null || echo "ntfy failed"
fi
[ -z "$problems" ]
